{
	"compilerOptions": {
		"module": "commonjs",
		"target": "ES2021",
		"strict": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"moduleResolution": "node",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"lib": [
			"ES2021"
		],
		"rootDir": ".",
		"noEmit": true
	},
	"include": [
		"src/**/*.ts",
		"shared/src/**/*.ts"
	]
}
